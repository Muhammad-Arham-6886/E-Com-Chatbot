# -------------------------------------------------------------
# AI Commerce Assistant SaaS - Production Environment Template
# -------------------------------------------------------------

# General & Security
ENVIRONMENT=production
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_min_32_chars!
ALLOWED_ORIGINS=https://your-domain.com,https://dashboard.your-domain.com

# PostgreSQL + pgvector
POSTGRES_DB=ai_commerce_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here

# Local Ollama AI & Embeddings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

# Server Concurrency
WEB_CONCURRENCY=4

# Next.js Public Config
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
